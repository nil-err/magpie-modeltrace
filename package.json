{
  "name": "modeltrace",
  "version": "0.2.0",
  "private": true,
  "description": "ModelTrace model attribution: a browser app (Cloudflare Pages) and magpie plugin tools that ask a model for long lists of first-instinct integers and score them against ModelTrace's fingerprint bank",
  "type": "module",
  "main": "./index.mjs",
  "keywords": [
    "modeltrace",
    "model-attribution",
    "model-fingerprint",
    "llm-gateway",
    "relay-detection",
    "magpie",
    "magpie-plugin",
    "cloudflare-pages"
  ],
  "license": "MIT",
  "author": "nil-err",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nil-err/magpie-modeltrace.git"
  },
  "homepage": "https://github.com/nil-err/magpie-modeltrace#readme",
  "bugs": {
    "url": "https://github.com/nil-err/magpie-modeltrace/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify:parity": "node scripts/verify-parity.mjs",
    "sync:bank": "node scripts/sync-bank.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name modeltrace --branch master"
  },
  "magpie": {
    "options": {
      "model": "",
      "exclude": [],
      "gateway": "http://127.0.0.1:3425",
      "budgetMs": 45000,
      "parallel": true
    }
  }
}
